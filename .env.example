# Database
DATABASE_URL=your_postgresql_connection_string

# Direct database connection (bypasses connection pooler for migrations)
# Required for build step - use unpooled/direct connection string
DATABASE_URL_DIRECT=your_direct_postgresql_connection_string

# Payload CMS
PAYLOAD_URL=http://localhost:3000
PAYLOAD_SECRET=your_payload_secret_key_here

# Redis Caching (REQUIRED — no in-process fallback exists anymore)
# Point local dev at the same Upstash instance prod uses. The APP_ENV
# prefix below keeps dev and prod key namespaces isolated inside one
# Redis, so dev writes can't overwrite prod values and dev cache flushes
# can't touch prod entries.
UPSTASH_REDIS_REST_URL=your_upstash_redis_url
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token

# App environment. Every cache key is stored under this prefix — so
# `events:upcoming:3` in the code becomes `dev:events:upcoming:3` or
# `prod:events:upcoming:3` in Redis. Set to `dev` locally; Vercel prod
# sets it to `prod`. Any other value (or empty) is treated as `dev`.
APP_ENV=dev

# Authorize.net Payments
AUTHNET_API_LOGIN_ID=your_api_login_id
AUTHNET_TRANSACTION_KEY=your_transaction_key
AUTHNET_ENVIRONMENT=sandbox
AUTHNET_PUBLIC_CLIENT_KEY=your_public_client_key
AUTHNET_SIGNATURE_KEY=your_signature_key

# Email (Resend)
RESEND_API_KEY=your_resend_api_key
EMAIL_FROM=Arcane Games <noreply@arcanegamesandevents.com>

# YouTube API (optional - falls back to hardcoded video if not configured)
YOUTUBE_API_KEY=your_youtube_api_key
# Optional: Override default channel/video IDs
# YOUTUBE_CHANNEL_ID=your_channel_id
# YOUTUBE_FALLBACK_VIDEO_ID=your_fallback_video_id

# Site URL (used for email links)
PUBLIC_BASE_URL=https://www.age.events

# Secret used to authenticate cron endpoint calls (subscription sync,
# cache warming). Vercel Cron sends this as `Authorization: Bearer
# ${CRON_SECRET}`. Any string works — just pick something unguessable
# and set the same value in the Vercel Project env vars. Missing/wrong
# secret = 401 from the cron endpoints. An admin session also passes
# the check so you can trigger them manually for debugging.
CRON_SECRET=some-long-random-string
