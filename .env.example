# =============================================================================
#  AGE website — environment variables
#
#  Copy this file to `.env` for local development and fill in the values.
#  Production values live in Vercel → Project → Settings → Environment
#  Variables. Never commit a real `.env`.
#
#  [required]  the site won't work properly without it
#  [optional]  the feature it powers is skipped or falls back when unset
#  [local]     only used on your own machine, not needed in Vercel
# =============================================================================


# -----------------------------------------------------------------------------
#  App
# -----------------------------------------------------------------------------

# [required] Which environment this is: `prod` or `dev`. Cache keys are stored
# under this prefix so dev and prod can share one Redis without touching each
# other's data. Set `prod` in Vercel's Production environment only; anything
# else (or empty) counts as `dev`.
APP_ENV=dev

# [optional] The site's public address, used for links in emails.
# Defaults to https://www.age.events.
PUBLIC_BASE_URL=https://www.age.events


# -----------------------------------------------------------------------------
#  Database (Supabase Postgres)
#  Supabase → Project Settings → Database → Connection string
# -----------------------------------------------------------------------------

# [required] The app's database connection. Use the pooler in transaction
# mode (port 6543).
DATABASE_URL=your_postgresql_connection_string

# [local] A session-mode connection (pooler port 5432) for running psql or
# pg_dump by hand, which need to keep one connection for the whole session.
# Not used by the app or the build.
DATABASE_URL_DIRECT=your_session_mode_connection_string


# -----------------------------------------------------------------------------
#  Cache (Upstash Redis)
#  Upstash console → your database → REST API
# -----------------------------------------------------------------------------

# [required] Page data is cached here. If unset, every request goes straight
# to the database (slow, but the site keeps working). Create the database in
# the same region as Supabase and Vercel (AWS us-west-2, Oregon). Local dev
# can point at the same instance as production; APP_ENV keeps them apart.
UPSTASH_REDIS_REST_URL=your_upstash_redis_url
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token


# -----------------------------------------------------------------------------
#  File storage (Supabase Storage)
#  Supabase → Project Settings → API
# -----------------------------------------------------------------------------

# [required for uploads] Stores images uploaded in the Desk. Needs a public
# bucket named `cms-media`. The service role key has full access to the
# project: server-side only, never expose it to the browser.
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key


# -----------------------------------------------------------------------------
#  Payments (Authorize.net)
#  Authorize.net merchant interface → Account → Settings → Security Settings
# -----------------------------------------------------------------------------

# [required for payments] API credentials for charging cards, saved cards
# and subscriptions.
AUTHNET_API_LOGIN_ID=your_api_login_id
AUTHNET_TRANSACTION_KEY=your_transaction_key

# [required for payments] `sandbox` for test payments, `production` for real
# ones. Defaults to `sandbox`, where the card forms also offer test card
# details.
AUTHNET_ENVIRONMENT=sandbox

# [required for payments] Verifies that payment webhooks really come from
# Authorize.net.
AUTHNET_SIGNATURE_KEY=your_signature_key


# -----------------------------------------------------------------------------
#  Video
# -----------------------------------------------------------------------------

# [required for video] Mux hosts uploaded videos (Library, Academy lessons,
# VODs). Mux dashboard → Settings → Access Tokens.
MUX_TOKEN_ID=your_mux_token_id
MUX_TOKEN_SECRET=your_mux_token_secret

# [required for video] Signs playback and thumbnail links for protected
# videos. Mux dashboard → Settings → Signing Keys. The private key is the
# base64 string Mux gives you.
MUX_SIGNING_KEY_ID=your_mux_signing_key_id
MUX_SIGNING_KEY_PRIVATE_KEY=your_mux_signing_key_private_key

# [required for video] Verifies Mux webhooks (upload finished, video ready).
# Mux dashboard → Settings → Webhooks → your webhook → Signing secret.
MUX_WEBHOOK_SIGNING_SECRET=your_mux_webhook_signing_secret

# [optional] Fills in the title, thumbnail and length when a YouTube link is
# added in the Desk. Google Cloud console → APIs → YouTube Data API v3.
YOUTUBE_API_KEY=your_youtube_api_key


# -----------------------------------------------------------------------------
#  Email (Resend)
#  Resend dashboard → API Keys
# -----------------------------------------------------------------------------

# [required for email] Sends password resets, receipts and account emails.
# Without it, emails are skipped.
RESEND_API_KEY=your_resend_api_key

# [optional] The sender shown on emails. Must use a domain verified in Resend.
EMAIL_FROM=AGE <info@arcanegamesandevents.com>


# -----------------------------------------------------------------------------
#  Security
# -----------------------------------------------------------------------------

# [optional] Cloudflare Turnstile CAPTCHA on the signup form.
# Cloudflare dashboard → Turnstile → your site. Without both keys the
# CAPTCHA is hidden and signups aren't checked.
TURNSTILE_SITE_KEY=your_turnstile_site_key
TURNSTILE_SECRET_KEY=your_turnstile_secret_key

# [required in production] Password for the scheduled jobs (subscription
# sync, cache warming). Vercel Cron sends it automatically when it's set in
# Vercel. Any long random string works.
CRON_SECRET=some-long-random-string
