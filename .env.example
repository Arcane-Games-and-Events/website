# Database
DATABASE_URL=your_postgresql_connection_string

# Direct database connection (bypasses connection pooler for migrations)
# Required for build step - use unpooled/direct connection string
DATABASE_URL_DIRECT=your_direct_postgresql_connection_string

# Payload CMS
PAYLOAD_URL=http://localhost:3000
PAYLOAD_SECRET=your_payload_secret_key_here

# Redis Caching (optional - falls back to direct DB queries if not configured)
UPSTASH_REDIS_REST_URL=your_upstash_redis_url
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token

# Authorize.net Payments
AUTHNET_API_LOGIN_ID=your_api_login_id
AUTHNET_TRANSACTION_KEY=your_transaction_key
AUTHNET_ENVIRONMENT=sandbox
AUTHNET_PUBLIC_CLIENT_KEY=your_public_client_key
AUTHNET_SIGNATURE_KEY=your_signature_key

# Email (Resend)
RESEND_API_KEY=your_resend_api_key
EMAIL_FROM=Arcane Games <noreply@arcanegamesandevents.com>

# YouTube API (optional - falls back to hardcoded video if not configured)
YOUTUBE_API_KEY=your_youtube_api_key
# Optional: Override default channel/video IDs
# YOUTUBE_CHANNEL_ID=your_channel_id
# YOUTUBE_FALLBACK_VIDEO_ID=your_fallback_video_id

# Site URL (used for email links)
PUBLIC_BASE_URL=https://www.age.events
