{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"crons": [
		{
			"path": "/api/cron/sync-subscriptions",
			"schedule": "0 0 * * *"
		},
		{
			"path": "/api/cron/warm-cache",
			"schedule": "*/5 * * * *"
		},
		{
			"path": "/api/cron/billing",
			"schedule": "15 * * * *"
		}
	],
	"headers": [
		{
			"source": "/hero_images/(.*)",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=604800, stale-while-revalidate=86400"
				}
			]
		},
		{
			"source": "/banner/(.*)",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=604800, stale-while-revalidate=86400"
				}
			]
		},
		{
			"source": "/images/(.*)",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=604800, stale-while-revalidate=86400"
				}
			]
		},
		{
			"source": "/(logo|age_open_logo|favicon).svg",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=604800, stale-while-revalidate=86400"
				}
			]
		},
		{
			"source": "/(.*).js",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=31536000, immutable"
				}
			]
		},
		{
			"source": "/(.*).css",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=31536000, immutable"
				}
			]
		}
	]
}
