# Database (PostgreSQL)
DATABASE_URI=postgresql://user:password@host:5432/database

# Payload CMS
PAYLOAD_SECRET=your_payload_secret_key_here

# Frontend URL (for webhooks and CORS)
FRONTEND_URL=http://localhost:5173

# Webhook secret for cache invalidation
PAYLOAD_WEBHOOK_SECRET=your_webhook_secret_here

# S3 Storage (Supabase)
S3_BUCKET=your_bucket_name
S3_ACCESS_KEY_ID=your_access_key
S3_SECRET_ACCESS_KEY=your_secret_key
S3_REGION=us-east-1
S3_ENDPOINT=https://your-project.supabase.co/storage/v1/s3
