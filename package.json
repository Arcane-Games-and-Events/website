{
	"name": "website",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"dev:https": "DEV_HTTPS_KEY=key.pem DEV_HTTPS_CERT=cert.pem vite dev",
		"build": "vite build",
		"build:ci": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"check": "svelte-kit sync && svelte-check --threshold error",
		"test": "vitest run --project unit",
		"test:integration": "vitest run --project integration",
		"test:e2e": "playwright test",
		"test:all": "vitest run && playwright test",
		"test:watch": "vitest --project unit",
		"test:db:up": "docker compose -f tests/docker-compose.yml up -d --wait",
		"test:db:down": "docker compose -f tests/docker-compose.yml down",
		"test:db:schema": "node scripts/refresh-test-schema.mjs"
	},
	"devDependencies": {
		"@eslint/compat": "^1.2.5",
		"@eslint/js": "^9.22.0",
		"@playwright/test": "^1.64.1",
		"@sveltejs/adapter-vercel": "^6.1.2",
		"@sveltejs/kit": "^2.22.0",
		"@sveltejs/vite-plugin-svelte": "^6.0.0",
		"@tailwindcss/forms": "^0.5.9",
		"@tailwindcss/typography": "^0.5.15",
		"@tailwindcss/vite": "^4.0.0",
		"@types/node": "^22",
		"drizzle-orm": "^0.40.0",
		"eslint": "^9.22.0",
		"eslint-config-prettier": "^10.0.1",
		"eslint-plugin-svelte": "^3.0.0",
		"globals": "^16.0.0",
		"prettier": "3.4.2",
		"prettier-plugin-svelte": "3.3.3",
		"prettier-plugin-tailwindcss": "^0.6.11",
		"svelte": "^5.0.0",
		"svelte-check": "^4.7.7",
		"tailwindcss": "^4.0.0",
		"vite": "^7.0.4",
		"vitest": "^3.2.7"
	},
	"dependencies": {
		"@flesh-and-blood/cards": "^4.0.60",
		"@flesh-and-blood/search": "^4.0.60",
		"@fontsource-variable/archivo": "^5.3.0",
		"@fontsource-variable/inter": "^5.3.0",
		"@fontsource-variable/jost": "^5.3.0",
		"@fontsource-variable/libre-franklin": "^5.3.0",
		"@fontsource-variable/newsreader": "^5.3.0",
		"@lexical/history": "^0.44.0",
		"@lexical/link": "^0.44.0",
		"@lexical/list": "^0.44.0",
		"@lexical/rich-text": "^0.44.0",
		"@lexical/selection": "^0.44.0",
		"@lexical/utils": "^0.44.0",
		"@lucia-auth/adapter-drizzle": "^1.1.0",
		"@mux/mux-node": "^12.8.1",
		"@mux/mux-player": "^3.11.4",
		"@mux/upchunk": "^3.5.0",
		"@supabase/supabase-js": "^2.112.2",
		"@upstash/redis": "^1.35.7",
		"authorizenet": "^1.0.10",
		"diff": "^9.0.0",
		"lexical": "^0.44.0",
		"lucia": "^3.2.2",
		"nanoid": "^5.1.6",
		"oslo": "^1.2.1",
		"postgres": "^3.4.5",
		"resend": "^6.5.2",
		"sharp": "^0.34.5",
		"svelte-dnd-action": "0.9.80"
	}
}
